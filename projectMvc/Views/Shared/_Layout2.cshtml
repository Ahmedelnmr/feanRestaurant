<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Layout - FEANE</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="/css/aStyle.css" rel="stylesheet"> 
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="logo">
            <h2>🍽️ FEANE</h2>
            <p>Restaurant Admin</p>
        </div>
        <nav>
            <a href="/Admin/Menu" class="nav-link active">
                <i class="fas fa-utensils"></i>
                <span>Menu</span>
            </a>
            <a href="/Admin/Orders" class="nav-link">
                <i class="fas fa-shopping-cart"></i>
                <span>Orders</span>
            </a>
            <a href="/Admin/Categories" class="nav-link">
                <i class="fas fa-layer-group"></i>
                <span>Categories</span>
            </a>
   
            <hr>
            <a href="/Account/signout" class="nav-link">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
        </nav>
    </div>
      <div class="main-content">
        <div class="navbar-top">
            <h4>@ViewData["Title"]</h4>
            <div class="admin-profile">
                <span>Admin User</span>
                <div class="admin-avatar">AD</div>
            </div>
        </div>
       
 
        <div class="content-area">
   
            @RenderBody()
        </div>
    </div>
    <script src="~/js/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
    <script src="~/js/bootstrap.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <script src="https://unpkg.com/isotope-layout@3.0.4/dist/isotope.pkgd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-nice-select/1.1.0/js/jquery.nice-select.min.js"></script>
    <script src="~/js/custom.js"></script>

    <!-- validation libraries MUST load after jQuery and before any code that relies on them -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>

