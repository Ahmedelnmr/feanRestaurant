@model projectMvc.Models.viewmodels.RegisterViewmodel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}


<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        overflow-x: hidden;
    }

    .auth-wrapper {
        min-height: 100vh;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .auth-wrapper::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=1920');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        filter: blur(2px) brightness(0.9);
        z-index: 1;
    }

    .auth-wrapper::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(0,0,0,0.85) 0%, rgba(20,20,20,0.9) 100%);
        z-index: 2;
    }

    .auth-container {
        position: relative;
        z-index: 3;
        width: 100%;
        max-width: 500px;
    }

    .auth-card {
        background: rgba(20, 20, 20, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 25px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8),
                    0 0 0 1px rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 140, 0, 0.2);
    }

    .auth-header {
        background: linear-gradient(135deg, #ff8c00 0%, #ff6600 100%);
        padding: 45px 40px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .auth-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        animation: rotate 20s linear infinite;
    }

    keyframes rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .logo-container {
        position: relative;
        z-index: 2;
    }

    .logo-icon {
        font-size: 65px;
        margin-bottom: 12px;
        display: inline-block;
        animation: bounce 2s ease-in-out infinite;
        filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));
    }

    keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    .auth-header h1 {
        color: #fff;
        font-size: 30px;
        font-weight: 800;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 2px;
        text-shadow: 2px 2px 8px rgba(0,0,0,0.4);
    }

    .auth-header p {
        color: rgba(255,255,255,0.95);
        font-size: 14px;
        font-weight: 500;
    }

    .auth-body {
        padding: 40px 40px;
        background: rgba(15, 15, 15, 0.98);
    }

    .welcome-text {
        color: #ff8c00;
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 8px;
        text-align: center;
    }

    .subtitle-text {
        color: rgba(255,255,255,0.6);
        font-size: 14px;
        text-align: center;
        margin-bottom: 30px;
    }

    .alert {
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 20px;
        border: none;
        font-size: 14px;
    }

    .alert-danger {
        background: rgba(220, 53, 69, 0.15);
        border-left: 4px solid #dc3545;
        color: #ff6b6b;
    }

    .alert-success {
        background: rgba(40, 167, 69, 0.15);
        border-left: 4px solid #28a745;
        color: #51cf66;
    }

    .form-group {
        margin-bottom: 22px;
        position: relative;
    }

    .form-label {
        color: #ff8c00;
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 8px;
        display: block;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .form-control {
        width: 100%;
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255, 140, 0, 0.3);
        border-radius: 12px;
        padding: 13px 16px;
        font-size: 15px;
        color: #fff;
        transition: all 0.3s ease;
    }

    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.3);
    }

    .form-control:focus {
        outline: none;
        background: rgba(255, 140, 0, 0.08);
        border-color: #ff8c00;
        box-shadow: 0 0 0 4px rgba(255, 140, 0, 0.1),
                    0 0 20px rgba(255, 140, 0, 0.2);
    }

    .text-danger {
        color: #ff6b6b !important;
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }

    .password-hint {
        color: rgba(255, 255, 255, 0.4);
        font-size: 12px;
        margin-top: 6px;
        display: flex;
        align-items: center;
    }

    .password-hint::before {
        content: 'ℹ️';
        margin-right: 5px;
    }

    .form-check {
        display: flex;
        align-items: flex-start;
        margin: 25px 0;
    }

    .form-check-input {
        width: 18px;
        height: 18px;
        margin-right: 10px;
        margin-top: 2px;
        cursor: pointer;
        accent-color: #ff8c00;
        flex-shrink: 0;
    }

    .form-check-label {
        color: rgba(255, 255, 255, 0.7);
        font-size: 13px;
        cursor: pointer;
        user-select: none;
        line-height: 1.5;
    }

    .form-check-label a {
        color: #ff8c00;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s ease;
    }

    .form-check-label a:hover {
        color: #ffa500;
        text-decoration: underline;
    }

    .btn-register {
        width: 100%;
        background: linear-gradient(135deg, #ff8c00 0%, #ff6600 100%);
        border: none;
        border-radius: 12px;
        padding: 16px;
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 6px 25px rgba(255, 140, 0, 0.4);
        position: relative;
        overflow: hidden;
    }

    .btn-register::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        transform: translate(-50%, -50%);
        transition: width 0.6s, height 0.6s;
    }

    .btn-register:hover::before {
        width: 300px;
        height: 300px;
    }

    .btn-register:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 35px rgba(255, 140, 0, 0.5);
    }

    .btn-register:active {
        transform: translateY(-1px);
    }

    .divider {
        display: flex;
        align-items: center;
        margin: 30px 0;
    }

    .divider::before,
    .divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: rgba(255, 140, 0, 0.2);
    }

    .divider span {
        padding: 0 15px;
        color: rgba(255, 255, 255, 0.4);
        font-size: 13px;
    }

    .auth-footer {
        text-align: center;
        padding-top: 25px;
        border-top: 1px solid rgba(255, 140, 0, 0.2);
    }

    .auth-footer p {
        color: rgba(255, 255, 255, 0.6);
        font-size: 14px;
        margin-bottom: 12px;
    }

    .auth-footer a {
        color: #ff8c00;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        position: relative;
    }

    .auth-footer a::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 2px;
        background: #ff8c00;
        transition: width 0.3s ease;
    }

    .auth-footer a:hover {
        color: #ffa500;
    }

    .auth-footer a:hover::after {
        width: 100%;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        color: rgba(255, 255, 255, 0.5);
        font-size: 13px;
        margin-top: 10px;
    }

    .back-link:hover {
        color: #ff8c00;
    }

    media (max-width: 576px) {
        .auth-header {
            padding: 35px 30px;
        }

        .auth-body {
            padding: 30px 25px;
        }

        .auth-header h1 {
            font-size: 24px;
        }

        .logo-icon {
            font-size: 55px;
        }

        .form-group {
            margin-bottom: 18px;
        }
    }
</style>

<div class="auth-wrapper">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <div class="logo-container">
                    <div class="logo-icon">👨‍🍳</div>
                    <h1>Join Us</h1>
                    <p>Create Your Account</p>
                </div>
            </div>

            <div class="auth-body">
                <h2 class="welcome-text">Get Started</h2>
                <p class="subtitle-text">Fill in your information to create an account</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>⚠️</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}




                <form asp-action="Register" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    
                    <div class="form-group">
                        <label asp-for="Name" class="form-label">Full Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter your full name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="your.email@example.com" type="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" placeholder="Create a strong password" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <div class="password-hint">
                            Use at least 8 characters with letters and numbers
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter your password" type="password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="termsCheck" required />
                        <label class="form-check-label" for="termsCheck">
                            I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>
                        </label>
                    </div>

                    <button type="submit" class="btn-register">Create Account</button>

                    <div class="divider">
                        <span>OR</span>
                    </div>

                    <div class="auth-footer">
                        <p>Already have an account? <a asp-action="Login">Sign In</a></p>
                        <a asp-action="Index" class="back-link">← Back to Home</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}