@model List<projectMvc.Models.models.CartItem>
@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout1.cshtml";

    decimal subtotal = Model.Sum(x => x.SubTotal);
    var now = DateTime.Now;

    // ===== حساب الخصومات =====
    decimal happyHourDiscount = (now.Hour >= 15 && now.Hour < 17) ? subtotal * 0.20m : 0m;
    decimal afterHappyHour = subtotal - happyHourDiscount;

    decimal bulkDiscount = (afterHappyHour > 100m) ? afterHappyHour * 0.10m : 0m;
    decimal discountedSubtotal = afterHappyHour - bulkDiscount;

    decimal tax = discountedSubtotal * 0.085m;
    decimal deliveryFee = 5m; // ثابت للتوصيل
    decimal total = discountedSubtotal + tax; // deliveryFee يضاف فقط لو اختر Delivery
}

<div class="container mt-5 mb-5">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header" style="background-color: #222831; color: white;">
                    <h4 class="mb-0"><i class="fa fa-shopping-bag"></i> Checkout</h4>
                </div>
                <div class="card-body">
                    <form asp-action="PlaceOrder" method="post" id="checkoutForm">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Order Type *</label>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <input type="radio" class="btn-check" name="orderType" id="dineIn" value="0" checked>
                                    <label class="btn btn-outline-primary w-100 py-3" for="dineIn">
                                        <i class="fa fa-utensils fa-2x d-block mb-2"></i>
                                        <strong>Dine In</strong>
                                        <small class="d-block text-muted">Eat at restaurant</small>
                                    </label>
                                </div>
                                <div class="col-md-4">
                                    <input type="radio" class="btn-check" name="orderType" id="takeout" value="1">
                                    <label class="btn btn-outline-primary w-100 py-3" for="takeout">
                                        <i class="fa fa-shopping-bag fa-2x d-block mb-2"></i>
                                        <strong>Takeout</strong>
                                        <small class="d-block text-muted">Pickup from restaurant</small>
                                    </label>
                                </div>
                                <div class="col-md-4">
                                    <input type="radio" class="btn-check" name="orderType" id="delivery" value="2">
                                    <label class="btn btn-outline-primary w-100 py-3" for="delivery">
                                        <i class="fa fa-motorcycle fa-2x d-block mb-2"></i>
                                        <strong>Delivery</strong>
                                        <small class="d-block text-muted">Deliver to home</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4" id="addressSection" style="display: none;">
                            <label for="deliveryAddress" class="form-label fw-bold">
                                <i class="fa fa-map-marker-alt"></i> Delivery Address *
                            </label>
                            <textarea class="form-control" id="deliveryAddress" name="deliveryAddress" 
                                      rows="3" placeholder="Enter full address (Street, Building No., Floor, Apartment)"></textarea>
                            <small class="text-muted">
                                <i class="fa fa-info-circle"></i> 
                                Please provide a detailed address to ensure successful delivery.
                            </small>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-4">
                            <h5 class="mb-3">
                                <i class="fa fa-list"></i> Order Summary
                            </h5>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Product</th>
                                            <th>Price</th>
                                            <th class="text-center">Quantity</th>
                                            <th class="text-end">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <img src="~/images/@item.Image" 
                                                             style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" 
                                                             class="me-3" />
                                                        <div>
                                                            <strong>@item.Name</strong>
                                                            <small class="d-block text-muted">@item.Description?.Substring(0, Math.Min(50, item.Description.Length))...</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="fw-bold">$@item.Price.ToString("F2")</td>
                                                <td class="text-center">
                                                    <span class="badge bg-secondary" style="font-size: 16px;">@item.Quantity</span>
                                                </td>
                                                <td class="text-end fw-bold text-success">$@item.SubTotal.ToString("F2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a href="/User/Cart" class="btn btn-secondary btn-lg">
                                <i class="fa fa-arrow-left"></i> Back to Cart
                            </a>
                            <button type="submit" class="btn btn-lg" style="background-color: #ffbe33; color: white; border: none;">
                                <i class="fa fa-check-circle"></i> Confirm Order
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm sticky-top" style="top: 20px;">
                <div class="card-header" style="background-color: #ffbe33; color: white;">
                    <h5 class="mb-0"><i class="fa fa-receipt"></i> Payment Summary</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <strong>$@subtotal.ToString("F2")</strong>
                    </div>

                    @if (happyHourDiscount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Happy Hour (20% Off):</span>
                            <strong>- $@happyHourDiscount.ToString("F2")</strong>
                        </div>
                    }

                    @if (bulkDiscount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Bulk Discount (10% Off):</span>
                            <strong>- $@bulkDiscount.ToString("F2")</strong>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax (8.5%):</span>
                        <strong>$@tax.ToString("F2")</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2" id="deliveryFeeRow">
                        <span>Delivery Fee:</span>
                        <strong class="delivery-amount text-success">$0.00</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-4">
                        <span style="font-size: 20px; font-weight: bold;">Total:</span>
                        <strong style="font-size: 26px; color: #28a745;" class="total-amount">
                            $@((discountedSubtotal + tax).ToString("F2"))
                        </strong>
                    </div>

                    <div class="alert alert-info mb-3">
                        <i class="fa fa-clock"></i> 
                        <strong>Estimated Time:</strong>
                        <div class="estimated-time mt-1">25-35 minutes</div>
                    </div>

                    <div class="alert alert-success mb-0">
                        <i class="fa fa-credit-card"></i> 
                        <strong>Payment Method:</strong>
                        <div class="mt-1">Cash on Delivery</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const deliveryRadio = document.getElementById("delivery");
    const dineInRadio = document.getElementById("dineIn");
    const takeoutRadio = document.getElementById("takeout");
    const addressSection = document.getElementById("addressSection");
    const deliveryAddress = document.getElementById("deliveryAddress");
    const checkoutForm = document.getElementById("checkoutForm");

    const subtotal = @subtotal;
    const happyHourDiscount = @happyHourDiscount;
    const bulkDiscount = @bulkDiscount;
    const tax = @tax;
    const deliveryFee = 5;

    function updateTotal() {
        const isDelivery = deliveryRadio.checked;
        const discountedSubtotal = subtotal - happyHourDiscount - bulkDiscount;
        const total = discountedSubtotal + tax + (isDelivery ? deliveryFee : 0);

        document.querySelector(".total-amount").textContent = `$${total.toFixed(2)}`;
        document.querySelector(".delivery-amount").textContent = isDelivery ? `$${deliveryFee.toFixed(2)}` : "$0.00";

        const estimatedTime = document.querySelector(".estimated-time");
        if (isDelivery) {
            estimatedTime.textContent = "40-50 minutes";
        } else if (takeoutRadio.checked) {
            estimatedTime.textContent = "20-25 minutes";
        } else {
            estimatedTime.textContent = "25-35 minutes";
        }
    }

    function toggleAddressSection() {
        if (deliveryRadio.checked) {
            addressSection.style.display = "block";
            deliveryAddress.required = true;
        } else {
            addressSection.style.display = "none";
            deliveryAddress.required = false;
            deliveryAddress.value = "";
        }
        updateTotal();
    }

    deliveryRadio.addEventListener("change", toggleAddressSection);
    dineInRadio.addEventListener("change", toggleAddressSection);
    takeoutRadio.addEventListener("change", toggleAddressSection);

    checkoutForm.addEventListener("submit", function(e) {
        if (deliveryRadio.checked && !deliveryAddress.value.trim()) {
            e.preventDefault();
            alert("Please enter the delivery address");
            deliveryAddress.focus();
            return false;
        }
    });

    updateTotal();
});
</script>
}

<style>
    .btn-check:checked + .btn-outline-primary {
        background-color: #ffbe33;
        border-color: #ffbe33;
        color: white;
    }

    .btn-outline-primary {
        border: 2px solid #dee2e6;
        transition: all 0.3s ease;
    }

    .btn-outline-primary:hover {
        border-color: #ffbe33;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .sticky-top {
        position: sticky;
        top: 20px;
    }

    .table > tbody > tr > td {
        vertical-align: middle;
        padding: 1rem;
    }
</style>
