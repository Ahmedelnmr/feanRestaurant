@model List<projectMvc.Models.models.CartItem>
@{
    ViewData["Title"] = "Cart";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<div class="container mt-5 mb-5">
    <h2 class="mb-4">
        <i class="fa fa-shopping-cart"></i> Shopping Cart
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="cart-container">
        @if (Model != null && Model.Any())
        {
            <div class="row">
                <div class="col-md-8">
                    @foreach (var item in Model)
                    {
                        <div class="cart-item-box mb-3 p-3 border rounded shadow-sm" data-id="@item.ManuItemId">
                            <div class="row align-items-center">
                                <!-- Product Image -->
                                <div class="col-md-3 col-sm-12 mb-3 mb-md-0">
                                    <img src="~/images/@item.Image" 
                                         alt="@item.Name" 
                                         class="img-fluid rounded" 
                                         style="width: 100%; height: 150px; object-fit: cover;" />
                                </div>

                                <!-- Product Info -->
                                <div class="col-md-4 col-sm-12 mb-3 mb-md-0">
                                    <h5 class="mb-2">@item.Name</h5>
                                    <p class="text-muted small mb-2">
                                        @if (item.Description != null && item.Description.Length > 60)
                                        {
                                            @item.Description.Substring(0, 60)@:...
                                        }
                                        else
                                        {
                                            @item.Description
                                        }
                                    </p>
                                    <div class="text-success fw-bold" style="font-size: 18px;">
                                        $@item.Price.ToString("F2")
                                    </div>
                                </div>

                                <!-- Quantity Controls -->
                                <div class="col-md-3 col-sm-12 mb-3 mb-md-0">
                                    <div class="d-flex align-items-center justify-content-center">
                                        <button class="btn btn-sm btn-outline-secondary decrease-btn" 
                                                style="width: 40px; height: 40px;">
                                            <i class="fa fa-minus"></i>
                                        </button>
                                        <input type="text" 
                                               readonly 
                                               value="@item.Quantity"
                                               class="form-control text-center mx-2 quantity-input"
                                               style="width: 70px; font-weight: bold; font-size: 18px;" />
                                        <button class="btn btn-sm btn-outline-secondary increase-btn" 
                                                style="width: 40px; height: 40px;">
                                            <i class="fa fa-plus"></i>
                                        </button>
                                    </div>
                                    <div class="text-center mt-2">
                                        <small class="text-muted">Quantity</small>
                                    </div>
                                </div>

                                <!-- Subtotal & Remove -->
                                <div class="col-md-2 col-sm-12 text-center">
                                    <div class="mb-3">
                                        <strong style="font-size: 20px; color: #28a745;">
                                            $@item.SubTotal.ToString("F2")
                                        </strong>
                                        <div>
                                            <small class="text-muted">Subtotal</small>
                                        </div>
                                    </div>
                                    <button class="btn btn-danger btn-sm remove-btn w-100">
                                        <i class="fa fa-trash"></i> Remove
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* ======= حساب المبالغ ======= *@
                @{
                    var subtotal = Model.Sum(x => x.SubTotal);

                    var now = DateTime.Now;
                    bool isHappyHour = now.Hour >= 15 && now.Hour < 17;
                    decimal happyHourDiscount = isHappyHour ? subtotal * 0.20m : 0m;

                    decimal afterHappyHour = subtotal - happyHourDiscount;

                    bool isBulkDiscount = afterHappyHour > 100m;
                    decimal bulkDiscount = isBulkDiscount ? afterHappyHour * 0.10m : 0m;

                    decimal afterDiscounts = afterHappyHour - bulkDiscount;

                    decimal tax = afterDiscounts * 0.085m;

                    decimal finalTotal = afterDiscounts + tax;
                }

                <!-- Cart Summary Sidebar -->
                <div class="col-md-4">
                    <div class="card shadow-sm sticky-top" style="top: 20px;">
                        <div class="card-header" style="background-color: #ffbe33; color: white;">
                            <h5 class="mb-0">
                                <i class="fa fa-receipt"></i> Order Summary
                            </h5>
                        </div>
                       <div class="card-body">
                           <div class="d-flex justify-content-between mb-3 pb-2 border-bottom">
                               <span>Subtotal:</span>
                               <strong>$@subtotal.ToString("F2")</strong>
                           </div>

                           @if (isHappyHour)
                           {
                               <div class="d-flex justify-content-between mb-3 pb-2 border-bottom text-success">
                                   <span> Happy Hour (20% off):</span>
                                   <strong>- $@happyHourDiscount.ToString("F2")</strong>
                               </div>
                           }

                           @if (isBulkDiscount)
                           {
                               <div class="d-flex justify-content-between mb-3 pb-2 border-bottom text-success">
                                   <span> Bulk Discount (10% off):</span>
                                   <strong>- $@bulkDiscount.ToString("F2")</strong>
                               </div>
                           }

                           <div class="d-flex justify-content-between mb-3 pb-2 border-bottom">
                               <span>Tax (8.5%):</span>
                               <strong>$@tax.ToString("F2")</strong>
                           </div>

                           <div class="d-flex justify-content-between mb-4">
                               <span style="font-size: 20px; font-weight: bold;">Total:</span>
                               <strong style="font-size: 26px; color: #28a745;">
                                   $@finalTotal.ToString("F2")
                               </strong>
                           </div>

                           <div class="alert alert-info small mb-3">
                               <i class="fa fa-info-circle"></i>
                               <strong>Estimated Time:</strong> 25-35 minutes
                           </div>

                           <a href="/User/Checkout" class="btn btn-checkout w-100 mb-2">
                               <i class="fa fa-credit-card"></i> Place Order
                           </a>
                           <a href="/User/Menu" class="btn btn-continue w-100">
                               <i class="fa fa-arrow-left"></i> Continue Shopping
                           </a>
                       </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center p-5 border rounded" style="background-color: #f8f9fa;">
                <div class="mb-4">
                    <i class="fa fa-shopping-cart" style="font-size: 120px; color: #dee2e6;"></i>
                </div>
                <h4 class="mb-3">Your cart is empty 😕</h4>
                <p class="text-muted mb-4">Start adding some delicious items to your cart!</p>
                <a href="/User/Menu" class="btn btn-lg" style="background-color: #ffbe33; color: white; border: none;">
                    <i class="fa fa-utensils"></i> Browse Menu
                </a>
            </div>
        }
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Increase quantity
            document.querySelectorAll(".increase-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    const parent = this.closest(".cart-item-box");
                    const id = parent.dataset.id;

                    fetch(`/User/IncreaseQuantity/${id}`, { 
                        method: "POST",
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                        }
                    })
                    .then(res => {
                        if (res.ok) {
                            location.reload();
                        } else {
                            alert("Error updating quantity");
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        alert("Connection error");
                    });
                });
            });

            // Decrease quantity
            document.querySelectorAll(".decrease-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    const parent = this.closest(".cart-item-box");
                    const id = parent.dataset.id;

                    fetch(`/User/DecreaseQuantity/${id}`, { 
                        method: "POST",
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                        }
                    })
                    .then(res => {
                        if (res.ok) {
                            location.reload();
                        } else {
                            alert("Error updating quantity");
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        alert("Connection error");
                    });
                });
            });

            // Remove item
            document.querySelectorAll(".remove-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    if (!confirm("Are you sure you want to remove this item?")) return;

                    const parent = this.closest(".cart-item-box");
                    const id = parent.dataset.id;

                    fetch(`/User/RemoveFromCart/${id}`, { 
                        method: "POST",
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                        }
                    })
                    .then(res => {
                        if (res.ok) {
                            parent.style.transition = "opacity 0.3s ease";
                            parent.style.opacity = "0";
                            setTimeout(() => location.reload(), 300);
                        } else {
                            alert("Error removing item");
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        alert("Connection error");
                    });
                });
            });
        });
    </script>
}

<style>
    .btn-continue {
        display: inline-block;
        padding: 12px 25px;
        background-color: #222831;
        color: #ffffff;
        border-radius: 6px;
        border: 2px solid #222831;
        transition: all 0.3s;
        text-transform: uppercase;
        font-size: 14px;
        text-decoration: none;
        font-weight: 600;
    }

    .btn-continue:hover {
        background-color: transparent;
        color: #222831;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .btn-checkout {
        display: inline-block;
        padding: 12px 25px;
        background-color: #ffbe33;
        color: #ffffff;
        border-radius: 6px;
        border: 2px solid #ffbe33;
        transition: all 0.3s;
        text-transform: uppercase;
        font-weight: 600;
        font-size: 16px;
        text-decoration: none;
    }

    .btn-checkout:hover {
        background-color: #e5a82e;
        border-color: #e5a82e;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(255, 190, 51, 0.4);
    }

    .cart-item-box {
        transition: all 0.3s ease;
        background: white;
    }

    .cart-item-box:hover {
        box-shadow: 0 6px 16px rgba(0,0,0,0.12);
        transform: translateY(-2px);
    }

    .sticky-top {
        position: sticky;
        top: 20px;
    }

    .btn-outline-secondary:hover {
        background-color: #222831;
        border-color: #222831;
        color: white;
    }

    media (max-width: 768px) {
        .sticky-top {
            position: relative;
            top: 0;
            margin-top: 20px;
        }
    }
</style>
