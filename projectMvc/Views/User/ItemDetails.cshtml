@using projectMvc.Models.models
@model ManuItem
@{
    ViewData["Title"] = "ItemDetails";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<!-- Menu Details Section -->
<section class="food_section layout_padding">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>Menu Item Details</h2>
        </div>

        <div class="row mt-5">
            <div class="col-md-6">
                <div class="box">
                    <div class="img-box">
                        <img src="~/images/@Model.Image" alt="Delicious Pizza" class="img-fluid" />
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="detail-box">
                    <h3>@Model.Name</h3>
                    <p class="mt-3" style="color: #ffbe33; font-size: 24px; font-weight: bold;">
                        @Model.Price.ToString("C")
                    </p>
                    <p class="mt-4" style="line-height: 1.8; color: #333;">
                        @Model.Description
                    </p>

                    <div class="options mt-4">
                        <h5 class="mb-3">Select Quantity:</h5>
                        <div class="quantity-selector d-flex align-items-center">
                            <button class="btn btn-sm" style="background-color: #222831; color: #fff; width: 40px; height: 40px;">
                                <i class="fa fa-minus"></i>
                            </button>
                            <input type="number" value="1" min="1" class="form-control mx-3 text-center" 
                                   style="width: 80px; height: 40px; font-size: 18px;" readonly />
                            <button class="btn btn-sm" style="background-color: #222831; color: #fff; width: 40px; height: 40px;">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>
                    </div>

                    <div class="btn-box mt-4">
                   <form asp-controller="User" asp-action="AddToCart" method="post" id="addToCartForm">
    <input type="hidden" name="manuItemId" value="@Model.Id" />
    <input type="hidden" id="quantityInput" name="quantity" value="1" />

    <button type="submit" class="btn-1">Add to Cart</button>
</form>

                        <a href="/User/Menu" class="btn-2 ml-3">
                            Back to Menu
                        </a>
                    </div>
                </div>
            </div>
        </div>

     
</section>

<style>
    .btn-1, .btn-2 {
        display: inline-block;
        padding: 10px 45px;
        background-color: #ffbe33;
        color: #ffffff;
        border-radius: 0;
        border: 1px solid #ffbe33;
        transition: all 0.3s;
        text-transform: uppercase;
        font-size: 15px;
        text-decoration: none;
    }

    .btn-1:hover {
        background-color: transparent;
        color: #ffbe33;
    }

    .btn-2 {
        background-color: #222831;
        border-color: #222831;
    }

    .btn-2:hover {
        background-color: transparent;
        color: #222831;
    }

    .quantity-selector input::-webkit-outer-spin-button,
    .quantity-selector input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .detail-box h3 {
        font-weight: bold;
        color: #222831;
        font-size: 32px;
    }

    .detail-box h5 {
        color: #222831;
        font-weight: 600;
    }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const minusBtn = document.querySelector(".quantity-selector .fa-minus").closest("button");
    const plusBtn = document.querySelector(".quantity-selector .fa-plus").closest("button");
    const input = document.querySelector(".quantity-selector input");
    const quantityInputHidden = document.getElementById("quantityInput");

    plusBtn.addEventListener("click", function (e) {
        e.preventDefault();
        let currentValue = parseInt(input.value);
        input.value = currentValue + 1;
        quantityInputHidden.value = input.value;
    });

    minusBtn.addEventListener("click", function (e) {
        e.preventDefault();
        let currentValue = parseInt(input.value);
        if (currentValue > 1) {
            input.value = currentValue - 1;
            quantityInputHidden.value = input.value;
        }
    });
});
</script>

