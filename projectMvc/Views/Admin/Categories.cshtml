
@using projectMvc.Models.models
@model List<Category>  
@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<style>
/* Table container */
.table-container {
    background-color: var(--light-gray);
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    overflow-x: auto;
}
a{
    text-decoration: none;
    color: black;
}
/* Table */
.table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 12px;
}

.table th, .table td {
    padding: 12px 15px;
    text-align: left;
    vertical-align: middle;
    color: #fff;
}

.table th {
    font-weight: 600;
    font-size: 14px;
    color: var(--gold);
}

.table td {
    background-color: var(--secondary-dark);
    border-radius: 8px;
}

/* Badges */
.badge-active {
    background-color: var(--gold);
    color: #000;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
}

.action-btn {
    border: none;
    background: transparent;
    color: var(--gold);
    font-size: 16px;
    cursor: pointer;
    margin-right: 5px;
    transition: transform 0.2s;
}

.action-btn:hover {
    transform: scale(1.2);
}

.edit-btn i { color: #4caf50; }
.delete-btn i { color: #f44336; }

/* Page Title */
.page-title {
    color: var(--gold);
    font-weight: 700;
}

/* Add Button */
.btn-gold {
    background: var(--gold);
    color: #000;
    border: none;
    padding: 8px 18px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s;
}

.btn-gold:hover {
    background: #ffca4d;
}

/* Modal Custom */
.modal-content {
    background-color: var(--secondary-dark);
    color: #fff;
    border-radius: 12px;
}

.modal-header {
    border-bottom: 1px solid rgba(255,190,51,0.3);
}

.modal-title {
    color: var(--gold);
}

.modal-footer {
    border-top: 1px solid rgba(255,190,51,0.3);
}

.btn-secondary {
    background-color: #444;
    color: #fff;
    border-radius: 8px;
}

.btn-secondary:hover {
    background-color: #555;
}
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title" style="margin-bottom:0;">Categories</h1>
    <button class="btn-gold" onclick="openMenuModal('add')">
      <a href="/Admin/Addcategory">  <i class="fas fa-plus"></i> Add New Category </a>
    </button>
</div>

<div class="table-container">
    <table class="table">
        <thead>
            <tr>
               
                <th>Name</th>
                <th>Descraiption</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>
                        <a href="/Admin/Updatecategory/@item.Id">   <button class="action-btn edit-btn" title="Edit" onclick="openMenuModal('edit', @item.Id)"><i class="fas fa-edit"></i></button> </a>
                                              <a href="/Admin/Deletecategory/@item.Id" 
   onclick="return confirm('Are you sure you want to delete this item?')" 
   class="action-btn delete-btn" title="Delete">
    <i class="fas fa-trash"></i>
</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    function openMenuModal(mode='add', id=null) {
        document.getElementById('menuModalTitle').textContent = mode==='add' ? 'Add Menu Item' : 'Edit Menu Item';
        const modal = new bootstrap.Modal(document.getElementById('menuModal'));
        modal.show();
        // هنا تقدر تضيف logic لتحميل بيانات العنصر إذا كان edit
    }

    function deleteItem(id) {
        if(confirm('Are you sure you want to delete this item?')) {
            // هنا تضيف منطق حذف العنصر باستخدام Ajax أو redirect
            console.log('Delete item id:', id);
        }
    }
</script>
